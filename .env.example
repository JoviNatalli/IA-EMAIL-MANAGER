# ── Database ──────────────────────────────────────────────────────────────
# Dev local sem instalar Postgres: `pnpm db:local` sobe um Postgres real
# (PGlite) em 127.0.0.1:5433 — ver dev-db/README.md.
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/postgres"
# Alternativa: Postgres.app / Homebrew / Docker local na 5432, ex.:
# DATABASE_URL="postgresql://nuvoly:nuvoly_dev_local@127.0.0.1:5432/nuvoly"
# Produção: aponte para Neon / Supabase / Railway / Vercel Postgres.

# ── Auth.js ───────────────────────────────────────────────────────────────
# Gerar com: npx auth secret   (ou: openssl rand -base64 33)
AUTH_SECRET="replace-me-with-a-random-32-byte-secret"

# Google OAuth (Fase 3 — Gmail). Deixe vazio na Fase 1/2.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── AI Providers (Fase 4+) ────────────────────────────────────────────────
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""

# Qual provider/modelo usar por padrão para cada tarefa (Fase 4+, camada de abstração).
AI_DEFAULT_PROVIDER="anthropic"

# ── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
